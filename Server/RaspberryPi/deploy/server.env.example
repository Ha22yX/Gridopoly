GRIDOPOLY_DATA_DIR=/var/lib/gridopoly
GRIDOPOLY_HTTP_PORT=80
GRIDOPOLY_SERVICE_IP=10.42.0.1
GRIDOPOLY_WEB_ASSET_DIR=/usr/local/share/gridopoly/tiles
GRIDOPOLY_AVATAR_COMPONENT_ROOT=/usr/local/share/gridopoly/avatar/components-v1
GRIDOPOLY_UDP_BIND=0.0.0.0
GRIDOPOLY_UDP_BROADCAST=10.42.0.255
# One authoritative bot decision per interval; accepted range is 100..10000 ms.
GRIDOPOLY_BOT_ACTION_INTERVAL_MS=1200
# Store the real shared commissioning secret only in /etc/gridopoly/server.env.
GRIDOPOLY_UDP_PSK=replace-with-at-least-16-random-characters
