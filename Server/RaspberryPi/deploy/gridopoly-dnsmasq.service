[Unit]
Description=Gridopoly AP DHCP and local DNS
After=gridopoly-ap.service
Requires=gridopoly-ap.service
Before=gridopoly.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --no-daemon --conf-file=/etc/gridopoly/dnsmasq.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
